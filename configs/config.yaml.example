# Server 配置
server:
  host: "0.0.0.0"
  port: 8080
  mode: "debug"  # debug, release, test

# 数据库配置
database:
  host: "127.0.0.1"
  port: 5432
  user: "postgres"
  password: "Flint@123456"
  dbname: "ruoyi-vue-pro"
  max_open_conns: 20
  max_idle_conns: 10
  conn_max_lifetime: "1h"

# 日志配置
log:
  level: "info"  # debug, info, warn, error
  format: "json"  # json, console
  output: "stdout"  # stdout, file
  file_path: "./logs/app.log"